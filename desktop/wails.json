{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "Peregrine",
  "outputfilename": "Peregrine",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Peregrine contributors"
  },
  "info": {
    "companyName": "Peregrine",
    "productName": "Peregrine",
    "productVersion": "0.3.1",
    "copyright": "Peregrine contributors, open source",
    "comments": "Free, open-source download manager",
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent file",
        "description": "BitTorrent file",
        "iconName": "torrentfile",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "scheme": "magnet",
        "description": "BitTorrent magnet link",
        "role": "Viewer"
      }
    ]
  }
}
